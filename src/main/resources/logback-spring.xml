<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %highlight(%-5level) [%cyan(%X{requestId})] %cyan(%logger{30}) - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO"><appender-ref ref="CONSOLE"/></root>
        <logger name="com.wallet.transfer" level="DEBUG"/>
        <logger name="org.springframework.transaction" level="DEBUG"/>
    </springProfile>
    <springProfile name="prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
        </appender>
        <root level="WARN"><appender-ref ref="JSON"/></root>
        <logger name="com.wallet.transfer" level="INFO"/>
    </springProfile>
</configuration>